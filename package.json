{
  "name": "@bemedev/codebase-monorepo",
  "private": true,
  "description": "The monorepo containing @bemedev/codebase CLI.",
  "author": {
    "email": "bri_lvi@icloud.com",
    "name": "chlbri",
    "url": "https://bemedev.vercel.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/codebase"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "pnpm:devPreinstall": "node ./pm.cjs",
    "build": "pnpm -r --sort run build",
    "config": "pnpm i",
    "rimraf": "pnpx rimraf -rf",
    "rinit": "pnpm run rm && pnpm run config",
    "lint": "pnpm run -r lint",
    "test": "pnpm run -r test",
    "pretest": "pnpm run -r pretest",
    "posttest": "pnpm run -r posttest",
    "test:only": "pnpm run -r test:only",
    "_ci": "pnpm install && pnpm run -r _ci",
    "ci": "CI=$(date +%s) && pnpm run _ci && echo \"\\n✅ CI takes $(($(date +%s) - CI))s\\n\"",
    "ci:admin": "CI_ADMIN=$(date +%s) && pnpm run rm && pnpm run up && pnpm run _ci && echo \"\\n✅ Admin CI takes $(($(date +%s) - CI_ADMIN))s\\n\"",
    "rm": "pnpm rimraf node_modules pnpm-lock.yaml && pnpm clean lockfile",
    "up": "pnpm up --latest && pnpm dlx npm-check-updates -w -u --peer --dep peer,optional,prod,packageManager !typescript",
    "prepare": "husky"
  },
  "devDependencies": {
    "@bemedev/decompose": "^2.2.0",
    "@bemedev/dev-utils": "^1.1.0",
    "@bemedev/fsf": "^1.0.1",
    "@size-limit/file": "^12.1.0",
    "@types/edit-json-file": "^1.7.4",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "glob": "^13.0.6",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "onchange": "^7.1.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "pretty-quick": "^4.2.2",
    "rolldown": "1.2.0",
    "size-limit": "^12.1.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.15.1"
}
